# macOS metadata
.DS_Store

# Plugin manager logs
nvim/nvim-pack-lock.json
nvim-lazy/lazy-lock.json

# Plugins cloned by tpack / zsh_add_plugin at runtime
/tmux/plugins/
/zsh/plugins/

# Shell history
/bash/.bash_history

# Zsh state and caches
/zsh/.zsh_history
/zsh/.zcompdump*
*.zwc

# btop's log
/btop/btop.log

# lazygit's own state (on Linux it is written next to config.yml; on macOS
# it stays in ~/Library/Application Support/lazygit)
/lazygit/state.yml
/lazygit/*.json
