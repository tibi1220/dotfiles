{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    {
      // LAN address of the interface used for the default route
      "type": "localip",
      "key": "Local IP",
      "showPrefixLen": false,
      "defaultRouteOnly": true
    },
    {
      // Queries ipinfo.io; skipped if it doesn't answer within 1 s
      "type": "publicip",
      "key": "Public IP",
      "timeout": 1000
    },
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
