#!/usr/bin/env zsh

# fzf: fuzzy finder. Only loaded if it is installed.
#   Ctrl-R   search command history
#   Ctrl-T   insert files/directories into the command line
#   Alt-C    cd into a subdirectory
#   **<Tab>  fuzzy completion (e.g. `nvim **<Tab>`, `cd **<Tab>`, `kill <Tab>`)
(( $+commands[fzf] )) || return 0

# FZF_* settings and previews are shared with bash: see $SHELLDIR/fzf.sh.

# fzf >= 0.48 ships its own zsh integration (`fzf --zsh`); older distro
# packages (e.g. Ubuntu 22.04, Raspberry Pi OS) ship separate scripts.
#
# Running `fzf --zsh` on every start costs a few ms, so its output is cached.
# The first line of the cache records which fzf binary wrote it (the resolved
# path includes the version, e.g. .../Cellar/fzf/0.67.0/bin/fzf), so the
# cache is rebuilt automatically after an upgrade.
#
# The scripts are sourced at the top level, not inside a function, so that
# everything they define stays global.
_fzf_init() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/fzf-init.zsh
  local header="# generated by: ${commands[fzf]:A}" first='' init dir

  # Cache still valid? (read is a builtin: no process is started)
  [[ -r $cache ]] && read -r first < $cache
  if [[ $first == $header ]]; then
    reply=($cache)
    return
  fi

  # Rebuild it
  if init=$(command fzf --zsh 2>/dev/null) && [[ -n $init ]]; then
    mkdir -p -- ${cache:h}
    print -r -- "$header"$'\n'"$init" >| $cache
    reply=($cache)
    return
  fi

  # Old fzf without --zsh: use the distro's scripts
  reply=()
  for dir in /usr/share/doc/fzf/examples /usr/share/fzf /usr/share/fzf/shell; do
    [[ -r $dir/key-bindings.zsh ]] || continue
    reply=($dir/key-bindings.zsh)
    [[ -r $dir/completion.zsh ]] && reply+=($dir/completion.zsh)
    return
  done
}

_fzf_init
for _fzf_file in $reply; do
  source $_fzf_file
done
unset -f _fzf_init
unset _fzf_file reply
